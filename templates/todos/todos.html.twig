{% extends 'base.html.twig' %}

{% block title %}Hello TodosController!{% endblock %}

{% block body %}
<h1>Todos</h1>
{% if app.user %}
            <p>
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
            </p>
            <table>
    <thead>
        <tr>
            <th>Task</th>
            <th>Due Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        
    {% for todo in todos %}
        <tr>
            <td>{{ todo.task }}</td>
            <td>{{ todo.duedate|date('d-m-Y') }}</td>
            <td>{{ todo.status }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% else %}
            <p>
            <a href="{{ path('app_register') }}">Register</a> or
            <a href="{{ path('app_login') }}">Login</a>
            </p>
{% endif %}

{% endblock %}

    
